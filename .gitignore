# Ambiente virtual do Python: cada computador cria o seu.
.venv/

# Arquivos que o Python, o pip e o pytest geram sozinhos.
__pycache__/
*.egg-info/
.pytest_cache/

# Arquivo que o Finder do Mac cria em cada pasta.
.DS_Store

dados/*
!dados/amostra-receitas.csv
!dados/amostra-despesas.csv

# Arquivos gerados pelos comandos: dá para gerar de novo a qualquer hora.
saida/